
@using Cura520.Models
@model List<Appointment>

@{
    ViewData["Title"] = "My Appointments";
}

<!-- Appointment Section -->
<section id="appointment" class="appointment section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2>My Appointments</h2>
        <p>View and manage your medical appointments</p>
    </div><!-- End Section Title -->

    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <!-- Success/Error Messages -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <strong>Success!</strong> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <strong>Error!</strong> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- New Appointment Button -->
        <div class="mb-4">
            <a asp-action="Create" asp-controller="Appointment" asp-area="Patient" class="btn btn-primary">
                <i class="bi bi-plus-circle me-2"></i> Request New Appointment
            </a>
        </div>

        <!-- Appointments Table -->
        @if (Model != null && Model.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Date & Time</th>
                            <th>Doctor</th>
                            <th>Symptoms</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var appointment in Model)
                        {
                            <tr>
                                <td>
                                    <span class="badge bg-info">@appointment.AppointmentDate.ToString("MMM dd, yyyy hh:mm tt")</span>
                                </td>
                                <td>
                                    <strong>Dr. @appointment.Doctor.FirstName @appointment.Doctor.LastName</strong>
                                    <br />
                                    <small class="text-muted">@appointment.Doctor.Specialty</small>
                                </td>
                                <td>
                                    <small>@(appointment.SymptomSummary.Length > 50 ? appointment.SymptomSummary.Substring(0, 50) + "..." : appointment.SymptomSummary)</small>
                                </td>
                                <td>
                                    @switch (appointment.Status)
                                    {
                                        case Status.Pending:
                                            <span class="badge bg-warning text-dark">Pending</span>
                                            break;
                                        case Status.Confirmed:
                                            <span class="badge bg-success">Confirmed</span>
                                            break;
                                        case Status.Completed:
                                            <span class="badge bg-info">Completed</span>
                                            break;
                                        case Status.Cancelled:
                                            <span class="badge bg-danger">Cancelled</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-controller="Appointment" asp-area="Patient" asp-route-id="@appointment.Id" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                    @if (appointment.Status != Status.Completed && appointment.Status != Status.Cancelled)
                                    {
                                        <form method="post" asp-action="Cancel" asp-route-id="@appointment.Id" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure you want to cancel this appointment?');">
                                                <i class="bi bi-x-circle"></i> Cancel
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle me-2"></i>
                <strong>No appointments yet.</strong> 
                <a asp-action="Create" asp-controller="Appointment" asp-area="Patient">Request your first appointment</a>
            </div>
        }

    </div>

</section><!-- /Appointment Section -->
