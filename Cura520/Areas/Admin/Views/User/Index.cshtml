@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = "Users Management";
}

<div class="container">
    <div class="row mb-3 align-items-center my-3">
        <div class="col-md-6">
            <h2 class="display-6">All Users</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            @if (Model != null && Model.Any())
            {
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th scope="col">#</th>
                            <th scope="col">Full Name</th>
                            <th scope="col">User Name</th>
                            <th scope="col">Email</th>
                            <th scope="col">Status</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <th scope="row">@item.Id</th>
                                <td>@item.FirstName @item.LastName</td>
                                <td>@item.UserName</td>
                                <td>@item.Email</td>
                                <td>
                                    @if (item.LockoutEnd != null && item.LockoutEnd > DateTime.UtcNow)
                                    {
                                        <span class="badge bg-danger">Locked</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                </td>
                                <td>
                                    @if (item.LockoutEnd != null && item.LockoutEnd > DateTime.UtcNow)
                                    {
                                        <form method="post" asp-action="LockUnLock" asp-route-id="@item.Id" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Are you sure you want to unlock this user?');">Unlock</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" asp-action="LockUnLock" asp-route-id="@item.Id" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to lock this user?');">Lock</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="alert alert-info">
                    No users found.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_NotificationPartial" />
}




